# Caddy : certificat Let's Encrypt automatique, en-tetes de cache et de securite.
# Remplacez vox.exemple.fr par votre domaine, puis : caddy run
# (le port 80 et le port 443 doivent etre joignables depuis l'exterieur).

vox.exemple.fr {
	encode zstd gzip

	# Le service worker et la page doivent toujours etre revalides,
	# sinon une mise a jour reste invisible chez les visiteurs.
	@nocache path / /index.html /sw.js /manifest.webmanifest
	header @nocache Cache-Control "no-cache, must-revalidate"

	@icons path /icon.svg /icon-maskable.svg /apple-touch-icon.png
	header @icons Cache-Control "public, max-age=604800"

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "SAMEORIGIN"
		Permissions-Policy "microphone=(self), camera=(), geolocation=(), payment=()"
		-Server
	}

	# Types MIME utiles a la PWA.
	header /manifest.webmanifest Content-Type "application/manifest+json"

	root * /srv/vox
	file_server

	log {
		output stdout
		format console
	}
}
